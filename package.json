{
  "name": "quickersql",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rs": "cd src-tauri && cargo test --quiet",
    "check:rs": "cd src-tauri && cargo check --quiet",
    "check:all": "cd src-tauri && cargo check --quiet && cd .. && npx vitest run",
    "tauri": "tauri",
    "e2e": "npx playwright test --config=e2e/playwright.config.ts",
    "e2e:headed": "npx playwright test --config=e2e/playwright.config.ts --headed",
    "e2e:report": "npx playwright show-report"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "ag-grid-community": "^35.2.1",
    "ag-grid-react": "^35.2.1",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.344.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^2.0.0",
    "zustand": "^5.0.0",
    "zustand-persist": "^0.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.9"
  }
}
