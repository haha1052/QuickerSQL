imary);\n}\n\n/* 全局按钮样式 - 完全排除Header内的按钮 */\n\ninput,\nbutton:not(.header-window-btn):not(.header-tab):not(.header-project-button):not(.header-settings-button) {\n  border-radius: 8px;\n  border: 1px solid var(--border-primary);\n  padding: 0.6em 1.2em;\n  font-size: 1em;\n  font-weight: 500;\n  font-family: inherit;\n  color: var(--text-primary);\n  background-color: var(--bg-secondary);\n  transition: border-color 0.25s, background-color 0.25s;\n  box-shadow: var(--shadow);\n}\n\nbutton:not(.header-window-btn):not(.header-tab):not(.header-project-button):not(.header-settings-button) {\n  cursor: pointer;\n}\n\nbutton:not(.header-window-btn):not(.header-tab):not(.header-project-button):not(.header-settings-button):hover {\n  border-color: var(--primary);\n}\n\nbutton:not(.header-window-btn):not(.header-tab):not(.header-project-button):not(.header-settings-button):active {\n  border-color: var(--primary);\n  background-color: var(--bg-tertiary);\n}\n\ninput,\nbutton:not(.header-window-btn):not(.header-tab):not(.header-project-button):not(.header-settings-button) {\n  outline: none;\n}\n\n#greet-input {\n  margin-right: 5px;\n}\n\n.rotated-icon {\n  transform: rotate(90deg);\n  transition: transform 0.2s;\n}\n\n/* AG Grid 主题适配 */\n\n.ag-theme-alpine {\n  --ag-foreground-color: var(--text-primary) !important;\n  --ag-background-color: var(--bg-primary) !important;\n  --ag-body-background-color: var(--bg-primary) !important;\n  --ag-viewport-background-color: var(--bg-primary) !important;\n  --ag-header-foreground-color: var(--text-primary) !important;\n  --ag-header-background-color: var(--bg-tertiary) !important;\n  --ag-row-border-color: var(--border-primary) !important;\n  --ag-border-color: var(--border-primary) !important;\n  --ag-selected-row-background-color: var(--primary-bg) !important;\n  --ag-row-hover-color: var(--bg-tertiary) !important;\n  --ag-header-column-separator-color: var(--border-secondary) !important;\n  --ag-odd-row-background-color: var(--bg-secondary) !important;\n  --ag-even-row-background-color: var(--bg-primary) !important;\n  --ag-range-selection-border-color: var(--primary) !important;\n  --ag-font-size: 13px !important;\n  --ag-header-font-size: 13px !important;\n}\n\n.ag-theme-alpine .ag-header {\n  background-color: var(--bg-tertiary) !important;\n}\n\n.ag-theme-alpine .ag-header-cell {\n  color: var(--text-primary) !important;\n  border-right: 1px solid var(--border-primary) !important;\n}\n\n.ag-theme-alpine .ag-cell {\n  color: var(--text-primary) !important;\n  border-right: 1px solid var(--border-primary) !important;\n}\n\n.ag-theme-alpine .ag-row {\n  background-color: var(--bg-primary) !important;\n}\n\n.ag-theme-alpine .ag-row-odd {\n  background-color: var(--bg-secondary) !important;\n}\n\n.ag-theme-alpine .ag-row-hover {\n  background-color: var(--bg-tertiary) !important;\n}\n\n.ag-theme-alpine .ag-row-selected {\n  background-color: var(--primary-bg) !important;\n}\n\n.ag-theme-alpine ::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n.ag-theme-alpine ::-webkit-scrollbar-track {\n  background: var(--bg-secondary);\n}\n\n.ag-theme-alpine ::-webkit-scrollbar-thumb {\n  background: var(--border-primary);\n  border-radius: 4px;\n}\n\n.ag-theme-alpine ::-webkit-scrollbar-thumb:hover {\n  background: var(--border-secondary);\n}\n\n/* ==================== HEADER 样式 ==================== */\n\n.header-container {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: 1px solid var(--border-primary);\n  background: var(--bg-tertiary);\n  height: 56px;\n}\n\n/* Header 左侧 */\n\n.header-left {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  flex-shrink: 0;\n}\n\n.header-logo {\n  font-size: 24px;\n  margin-left: 8px;\n  margin-right: 4px;\n  flex-shrink: 0;\n}\n\n.header-project-button {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 16px;\n  border: none;\n  background: transparent;\n  color: var(--text-primary);\n  cursor: pointer;\n  font-size: 14px;\n  border-radius: 4px;\n  -webkit-app-region: no-drag;\n}\n\n.header-project-button:hover {\n  background: var(--bg-primary);\n}\n\n.header-icon {\n  width: 18px;\n  height: 18px;\n}\n\n.header-project-label {\n  font-weight: 500;\n}\n\n.header-project-name {\n  color: var(--text-secondary);\n  background: var(--bg-primary);\n  padding: 2px 8px;\n  border-radius: 4px;\n  font-size: 13px;\n}\n\n.header-divider {\n  width: 1px;\n  height: 24px;\n  background: var(--border-primary);\n  margin: 0 8px;\n  flex-shrink: 0;\n}\n\n.header-tab {\n  padding: 8px 20px;\n  border: none;\n  background: transparent;\n  color: var(--text-secondary);\n  cursor: pointer;\n  font-size: 14px;\n  border-radius: 4px;\n  font-weight: 500;\n  transition: all 0.2s;\n  -webkit-app-region: no-drag;\n}\n\n.header-tab:hover {\n  color: var(--text-primary);\n  background: var(--bg-primary);\n}\n\n.header-tab-active {\n  background: var(--primary) !important;\n  color: white !important;\n  font-weight: bold;\n}\n\n/* Header 拖拽区域 */\n\n.header-drag-spacer {\n  flex: 1;\n  height: 100%;\n  -webkit-app-region: drag;\n  cursor: default;\n  min-width: 20px;\n}\n\n/* Header 右侧 */\n\n.header-right {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-shrink: 0;\n}\n\n.header-settings-button {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 40px;\n  height: 40px;\n  border: none;\n  background: transparent;\n  color: var(--text-secondary);\n  cursor: pointer;\n  border-radius: 4px;\n  transition: all 0.2s;\n  -webkit-app-region: no-drag;\n  pointer-events: auto;\n  position: relative;\n  z-index: 10;\n}\n\n.header-settings-button:hover {\n  color: var(--text-primary);\n  background: var(--bg-primary);\n}\n\n/* ==================== 窗口控制按钮 - 完全隔离 ==================== */\n\n.header-window-controls {\n  display: flex;\n  gap: 0;\n  -webkit-app-region: no-drag;\n  height: 100%;\n}\n\n/* 窗口按钮基础样式 - 完全排除所有全局button样式 */\n\n.header-window-btn {\n  width: 46px !important;\n  height: 56px !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  border: none !important;\n  background: transparent !important;\n  color: var(--text-secondary) !important;\n  cursor: pointer !important;\n  transition: all 0.15s !important;\n  -webkit-app-region: no-drag !important;\n  pointer-events: auto !important;\n  border-radius: 0 !important;\n  padding: 0 !important;\n  margin: 0 !important;\n  box-shadow: none !important;\n  outline: none !important;\n  line-height: 1 !important;\n  font-size: 0 !important;\n}\n\n.header-window-btn:hover {\n  background: var(--bg-primary) !important;\n  color: var(--text-primary) !important;\n}\n\n/* 关闭按钮特殊样式 */\n\n.header-window-close:hover {\n  background: #dc2626 !important;\n  color: white !important;\n}\n\n/* 窗口按钮图标 */\n\n.header-window-icon {\n  font-size: 20px;\n  line-height: 1;\n  color: inherit;\n}\n\n/* ==================== 仪表盘缩放手柄样式 ==================== */\n\n/* P0-2 修复：编辑模式下缩放手柄的 hover 高亮效果 */\n\n.resize-handle-right:hover,\n.resize-handle-right:active {\n  background: var(--primary) !important;\n  opacity: 0.6;\n}\n\n.resize-handle-bottom:hover,\n.resize-handle-bottom:active {\n  background: var(--primary) !important;\n  opacity: 0.6;\n}\n\n/* ==================== 工作区标签栏样式 ==================== */\n\n.workspace-tabs-container::-webkit-scrollbar {\n  height: 6px;\n}\n\n.workspace-tabs-container::-webkit-scrollbar-track {\n  background: var(--bg-tertiary);\n}\n\n.workspace-tabs-container::-webkit-scrollbar-thumb {\n  background: var(--border-primary);\n  border-radius: 3px;\n}\n\n.workspace-tabs-container::-webkit-scrollbar-thumb:hover {\n  background: var(--text-tertiary);\n}"],["STYLE",{},".welcome-container {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  height: 100vh;\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n}\n\n.welcome-content {\n  color: white;\n  padding: 40px;\n  display: flex;\n  flex-direction: column;\n  gap: 50px;\n}\n\n.welcome-hero {\n  display: flex;\n  align-items: center;\n  gap: 40px;\n}\n\n.welcome-logo {\n  flex-shrink: 0;\n}\n\n.welcome-logo .logo-emoji {\n  font-size: 140px;\n  display: block;\n  line-height: 1;\n}\n\n.welcome-text {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  text-align: left;\n}\n\n.welcome-text .app-name {\n  font-size: 48px;\n  font-weight: 700;\n  margin: 0;\n}\n\n.welcome-text .app-tagline {\n  font-size: 18px;\n  opacity: 0.9;\n  margin: 0;\n}\n\n.welcome-actions {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n  align-items: center;\n}\n\n.btn-primary {\n  padding: 15px 60px;\n  font-size: 18px;\n  font-weight: 600;\n  border: none;\n  border-radius: 8px;\n  background: white;\n  color: #667eea;\n  cursor: pointer;\n  transition: transform 0.2s, box-shadow 0.2s;\n}\n\n.btn-primary:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);\n}\n\n.secondary-buttons {\n  display: flex;\n  gap: 20px;\n}\n\n.btn-secondary {\n  padding: 12px 30px;\n  font-size: 14px;\n  border: 1px solid rgba(255, 255, 255, 0.5);\n  border-radius: 6px;\n  background: transparent;\n  color: white;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.btn-secondary:hover {\n  background: rgba(255, 255, 255, 0.1);\n}\n"],["STYLE",{},".guide-container {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  height: 100vh;\n  background: #f5f7fa;\n}\n\n.guide-content {\n  width: 100%;\n  max-width: 600px;\n  background: white;\n  border-radius: 12px;\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);\n  overflow: hidden;\n}\n\n.guide-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 20px 30px;\n  border-bottom: 1px solid #eee;\n}\n\n.skip-btn {\n  background: none;\n  border: none;\n  color: #666;\n  cursor: pointer;\n  font-size: 14px;\n}\n\n.progress-dots {\n  display: flex;\n  gap: 10px;\n}\n\n.dot {\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  background: #ddd;\n}\n\n.dot.active {\n  background: #667eea;\n}\n\n.guide-body {\n  padding: 40px 30px;\n  text-align: center;\n}\n\n.step-icon {\n  font-size: 60px;\n  margin-bottom: 20px;\n}\n\n.import-step-icon {\n  margin-bottom: 30px;\n}\n\n.guide-card {\n  display: flex;\n  align-items: flex-start;\n  gap: 15px;\n  text-align: left;\n  background: #f9f9f9;\n  border-radius: 8px;\n  padding: 20px;\n  margin-top: 10px;\n}\n\n.guide-card .card-icon {\n  font-size: 32px;\n  flex-shrink: 0;\n}\n\n.guide-card .card-content h3 {\n  font-size: 16px;\n  color: #333;\n  margin: 0 0 10px 0;\n}\n\n.guide-card .card-content ul {\n  margin: 0;\n  padding-left: 0;\n  list-style: none;\n  color: #666;\n}\n\n.guide-card .card-content li {\n  margin-bottom: 8px;\n}\n\n.guide-body h2 {\n  font-size: 24px;\n  color: #333;\n  margin-bottom: 15px;\n}\n\n.guide-body p {\n  color: #666;\n  line-height: 1.6;\n  margin-bottom: 30px;\n}\n\n.placeholder-card {\n  background: #f9f9f9;\n  border: 2px dashed #ddd;\n  border-radius: 8px;\n  padding: 40px;\n  margin-bottom: 10px;\n}\n\n.placeholder-card p {\n  color: #999;\n  margin: 0;\n}\n\n.quick-tips {\n  text-align: left;\n  background: #f0f5ff;\n  border-radius: 8px;\n  padding: 20px;\n}\n\n.quick-tips p {\n  margin-bottom: 10px;\n  color: #555;\n}\n\n.quick-tips ul {\n  margin: 0;\n  padding-left: 20px;\n  color: #666;\n}\n\n.quick-tips li {\n  margin-bottom: 8px;\n}\n\n.guide-footer {\n  display: flex;\n  align-items: center;\n  gap: 15px;\n  padding: 20px 30px;\n  border-top: 1px solid #eee;\n}\n\n.btn {\n  padding: 12px 24px;\n  border-radius: 6px;\n  font-size: 14px;\n  font-weight: 500;\n  cursor: pointer;\n  border: none;\n  transition: all 0.2s;\n}\n\n.btn-back {\n  background: #f5f7fa;\n  color: #666;\n}\n\n.btn-back:hover {\n  background: #e9ecef;\n}\n\n.btn-next {\n  background: #667eea;\n  color: white;\n}\n\n.btn-next:hover {\n  background: #5568d3;\n}\n\n.btn-complete {\n  background: #667eea;\n  color: white;\n  font-size: 16px;\n  padding: 14px 30px;\n}\n\n.btn-complete:hover {\n  background: #5568d3;\n}\n"],["STYLE",{},"/* ============================================================\n   QuickerSQL 主题系统（浅色/深色/跟随系统）\n\n   ⚠️ 透明背景约定（修改前必读）：\n   - html / body / #root 三个元素必须保持 transparent 背景色\n   - 直到启动完成、由 AppWrapper.tsx 显式设置 body.style.background 之前\n   - 主应用背景色由 .app-shell 类或内联 style={{ background: 'var(--bg-primary)' }} 控制\n   - html/body/#root 的 transition 必须为 none（避免 0.3s 白屏闪烁）\n   - 禁止在任何 CSS 文件给 html/body/#root 设置非 transparent 背景色\n   - 禁止在 body 的 transition 中包含 background-color（启动时会产生白屏）\n   ============================================================ */\n\n/* 基础样式重置 */\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n  transition: border-color 0.3s ease,\n              color 0.3s ease,\n              box-shadow 0.3s ease;\n}\n\n/* html/body/#root 保持 transparent，无任何背景色过渡（禁止白屏闪烁） */\nhtml, body, #root {\n  background-color: transparent !important;\n  background: transparent !important;\n  transition: none !important;\n  -webkit-transition: none !important;\n}\n\nbody {\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;\n}\n\n/* ================================\n   浅色模式 (Light Mode) - 默认\n   ================================ */\n:root {\n  /* 背景 */\n  --bg-primary: #f5f7fa;\n  --bg-secondary: #ffffff;\n  --bg-tertiary: #f3f4f6;\n  \n  /* 边框 */\n  --border-primary: #e5e7eb;\n  --border-secondary: #d1d5db;\n  \n  /* 文字 */\n  --text-primary: #1f2937;\n  --text-secondary: #6b7280;\n  --text-tertiary: #9ca3af;\n  \n  /* 主色 */\n  --primary: #667eea;\n  --primary-hover: #5568d3;\n  --primary-bg: #eef2ff;\n  \n  /* 成功 */\n  --success: #16a34a;\n  --success-bg: #f0fdf4;\n  \n  /* 警告 */\n  --warning: #d97706;\n  --warning-bg: #fffbeb;\n  \n  /* 错误 */\n  --error: #dc2626;\n  --error-bg: #fef2f2;\n  \n  /* 阴影 */\n  --shadow: 0 2px 8px rgba(0, 0, 0, 0.05);\n  --shadow-hover: 0 4px 16px rgba(0, 0, 0, 0.08);\n}\n\n/* ================================\n   深色模式 (Dark Mode)\n   ================================ */\n[data-theme=\"dark\"] {\n  /* 背景 */\n  --bg-primary: #0f172a;\n  --bg-secondary: #1e293b;\n  --bg-tertiary: #334155;\n  \n  /* 边框 */\n  --border-primary: #334155;\n  --border-secondary: #475569;\n  \n  /* 文字 */\n  --text-primary: #f1f5f9;\n  --text-secondary: #94a3b8;\n  --text-tertiary: #64748b;\n  \n  /* 主色 */\n  --primary: #818cf8;\n  --primary-hover: #6366f1;\n  --primary-bg: #1e293b;\n  \n  /* 成功 */\n  --success: #22c55e;\n  --success-bg: #064e3b;\n  \n  /* 警告 */\n  --warning: #f59e0b;\n  --warning-bg: #451a03;\n  \n  /* 错误 */\n  --error: #ef4444;\n  --error-bg: #450a0a;\n  \n  /* 阴影 */\n  --shadow: 0 2px 8px rgba(0, 0, 0, 0.2);\n  --shadow-hover: 0 4px 16px rgba(0, 0, 0, 0.3);\n}\n\n/* ================================\n   全局基础样式\n   ================================ */\n/* ⚠️ 重要：html/body/#root 的透明背景和 transition 已在文件顶部定义\n   这里只设置高度和默认文本颜色，避免重复规则 */\nhtml, body, #root {\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  color: var(--text-primary);\n}\n\n/* 主应用内容容器（启动完成后才显示背景色） */\n.app-shell {\n  min-height: 100vh;\n  width: 100%;\n  background-color: var(--bg-primary);\n  color: var(--text-primary);\n}\n\n/* ================================\n   自定义滚动条样式\n   ================================ */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: var(--bg-secondary);\n}\n\n::-webkit-scrollbar-thumb {\n  background: var(--border-primary);\n  border-radius: 4px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: var(--border-secondary);\n}\n\n/* Firefox 滚动条样式 */\n* {\n  scrollbar-width: thin;\n  scrollbar-color: var(--border-primary) var(--bg-secondary);\n}\n"]],"\n\n  ",["BODY",{"class":"startup-phase"},"\n\n    ","\n    ",["DIV",{"id":"splash-screen"},"\n      ",["DIV",{"class":"splash-card"},"\n        ",["DIV",{"class":"splash-logo"},"\n          ",["SPAN",{"class":"splash-logo-text"},"Q"],"\n          ",["DIV",{"class":"splash-spinner"}],"\n        "],"\n        ",["DIV",{"class":"splash-title"},"QuickerSQL"],"\n        ",["DIV",{"class":"splash-subtitle"},"本地轻量高性能数据分析工具"],"\n        ",["DIV",{"class":"splash-progress-track"},"\n          ",["DIV",{"class":"splash-progress-bar"}],"\n        "],"\n        ",["DIV",{"class":"splash-stage","id":"splash-stage"},"正在加载资源..."],"\n        ",["DIV",{"class":"splash-timer","id":"splash-timer"},"启动中 · 675 ms"],"\n        ",["BUTTON",{"class":"splash-timeout-hint","id":"splash-timeout-btn","onclick":""},"\n          启动较慢？点击进入应用\n        "],"\n      "],"\n    "],"\n\n    ","\n    ",["DIV",{"id":"root","class":"startup-phase"}],"\n\n    ","\n\n    ","\n  \n\n"]],"viewport":{"width":1280,"height":720},"timestamp":798150.027,"wallTime":1786189672097,"collectionTime":1,"resourceOverrides":[],"isMainFrame":true}}
